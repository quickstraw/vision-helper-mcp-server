{
  "name": "vision-helper-mcp-server",
  "version": "1.1.1",
  "description": "MCP server that adds vision capability to any LLM by routing image analysis to vision-capable OpenRouter models",
  "author": "Nathaniel McGraw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quickstraw/vision-helper-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/quickstraw/vision-helper-mcp-server/issues"
  },
  "homepage": "https://github.com/quickstraw/vision-helper-mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vision-helper-mcp": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "vision",
    "openrouter",
    "image-analysis",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
